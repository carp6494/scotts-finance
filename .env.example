# Scott's Finance settings. Copy stays on this PC only.
# Get these from dashboard.plaid.com > Developers > Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# production (real banks) or sandbox (fake test banks: user_good / pass_good)
PLAID_ENV=production
# Optional: only if you registered a redirect URI in the Plaid dashboard
PLAID_REDIRECT_URI=
# Optional: override the ticker logo folder (default: assets\ticker-logos)
TICKER_LOGOS=
# 1 = open the browser automatically when the app starts
OPEN_BROWSER=1
